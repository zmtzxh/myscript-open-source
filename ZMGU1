local function findMatchingFeatureKey(searchTerm)
	local cleanTerm = string.lower(searchTerm)
	
	local sortedAliases = {}
	for alias, featKey in pairs(featureAliases) do
		table.insert(sortedAliases, {alias = alias, key = featKey})
	end
	table.sort(sortedAliases, function(a, b) return #a.alias > #b.alias end)
	
	for _, item in ipairs(sortedAliases) do
		if string.find(cleanTerm, "[^%w]" .. item.alias .. "[^%w]") or string.sub(cleanTerm, 1, #item.alias) == item.alias and ( #cleanTerm == #item.alias or string.sub(cleanTerm, #item.alias+1, #item.alias+1):match("[%p%s]") ) then
			return item.key
		end
	end
	
	for _, item in ipairs(sortedAliases) do
		if string.find(cleanTerm, item.alias) then
			return item.key
		end
	end
	
	return nil
end

local function applyDecalsToPart(part)
	if part:IsA("BasePart") and not part:IsDescendantOf(player.Character) then
		for _, face in ipairs(Enum.NormalId:GetEnumItems()) do
			local hasDecal = false
			for _, child in ipairs(part:GetChildren()) do
				if child:IsA("Decal") and child.Name == "ZMtxchDecal" and child.Face == face then
					child.Texture = DECAL_ASSET_ID
					hasDecal = true
					break
				end
			end
			
			if not hasDecal then
				pcall(function()
					local decal = Instance.new("Decal")
					decal.Name = "ZMtxchDecal"
					decal.Texture = DECAL_ASSET_ID
					decal.Face = face
					decal.Transparency = part.Transparency
					decal.Parent = part
				end)
			end
		end
	end
end

local function runFullMapDecalSpam()
	task.spawn(function()
		local allDescendants = Workspace:GetDescendants()
		for i = 1, #allDescendants do
			if not features.Decals then break end
			local obj = allDescendants[i]
			if obj:IsA("BasePart") then
				applyDecalsToPart(obj)
			end
			if i % 30 == 0 then task.wait() end
		end
	end)
end

-- Command Logic Handler
local function handleTerminalCommand(rawCmd)
	if rawCmd == "" then return end
	printConsole("> " .. rawCmd, Color3.fromRGB(255, 255, 255))
	
	local args = string.split(rawCmd, " ")
	local cmd = string.lower(args[1] or "")
	
	if cmd == "help" then
		printConsole("--- COMMAND & FEATURE LIST ---", Color3.fromRGB(0, 255, 0))
		printConsole("Fake Exploits: faketp, fakefling, cloneskin", Color3.fromRGB(255, 255, 0))
		printConsole("SS Modules: decals, disco, messages, particles, skybox", Color3.fromRGB(200, 200, 200))
		printConsole("Admin Commands: kick, kill, bring, btools, clear", Color3.fromRGB(200, 200, 200))
		
	elseif cmd == "clear" then
		for _, child in ipairs(consoleFrame:GetChildren()) do
			if child:IsA("TextLabel") then child:Destroy() end
		end
		printConsole("Console cleared.", Color3.fromRGB(150, 150, 150))
		
	elseif cmd == "kick" then
		local targetName = args[2]
		local reason = table.concat(args, " ", 3) or "Kicked by ZMtxch SS"
		if not targetName then printConsole("Error: Specify target player.", Color3.fromRGB(255, 50, 50)) return end
		
		local target = nil
		for _, p in ipairs(Players:GetPlayers()) do
			if string.find(string.lower(p.Name), string.lower(targetName)) then target = p break end
		end
		
		if target then
			if target == player then
				printConsole("Self-kick blocked by safety lock.", Color3.fromRGB(255, 150, 0))
			else
				target:Kick("[ZMtxch SS]: " .. reason)
				printConsole("Player " .. target.Name .. " kicked successfully.", Color3.fromRGB(0, 255, 0))
			end
		else
			printConsole("Player '" .. targetName .. "' not found.", Color3.fromRGB(255, 50, 50))
		end
		
	elseif cmd == "kill" then
		local targetName = args[2]
		if not targetName then printConsole("Error: Specify target player.", Color3.fromRGB(255, 50, 50)) return end
		
		local target = nil
		for _, p in ipairs(Players:GetPlayers()) do
			if string.find(string.lower(p.Name), string.lower(targetName)) then target = p break end
		end
		
		if target and target.Character then
			target.Character:BreakJoints()
			printConsole("Eliminated " .. target.Name .. ".", Color3.fromRGB(0, 255, 0))
		else
			printConsole("Player or character not found.", Color3.fromRGB(255, 50, 50))
		end

	elseif cmd == "bring" then
		local targetName = args[2]
		if not targetName then printConsole("Error: Specify target player.", Color3.fromRGB(255, 50, 50)) return end
		
		local target = nil
		for _, p in ipairs(Players:GetPlayers()) do
			if string.find(string.lower(p.Name), string.lower(targetName)) then target = p break end
		end
		
		if target and target.Character and player.Character then
			local myPos = player.Character:GetPivot()
			target.Character:PivotTo(myPos + Vector3.new(3, 0, 0))
			printConsole("Brought " .. target.Name .. " to your position.", Color3.fromRGB(0, 255, 0))
		else
			printConsole("Could not perform bring.", Color3.fromRGB(255, 50, 50))
		end

	elseif cmd == "btools" then
		for _, toolType in ipairs({"HopperBin"}) do
			for i = 1, 4 do
				local btool = Instance.new(toolType)
				btool.BinType = i
				btool.Parent = player.Backpack
			end
		end
		printConsole("Classic BTools given to Backpack.", Color3.fromRGB(0, 255, 0))

	else
		local matchedFeatureKey = findMatchingFeatureKey(rawCmd)
		
		if matchedFeatureKey then
			features[matchedFeatureKey] = not features[matchedFeatureKey]
			local newState = features[matchedFeatureKey] and "ENABLED" or "DISABLED"
			
			if matchedFeatureKey == "Decals" and features.Decals then runFullMapDecalSpam()
			elseif matchedFeatureKey == "Skybox" and toggleSkybox then toggleSkybox(features.Skybox)
			elseif matchedFeatureKey == "LightingTint" and toggleLighting then toggleLighting(features.LightingTint)
			elseif matchedFeatureKey == "AudioSpam" and toggleAudio then toggleAudio(features.AudioSpam)
			elseif matchedFeatureKey == "ZeroG" and toggleZeroG then toggleZeroG(features.ZeroG)
			elseif matchedFeatureKey == "FogLockdown" and toggleFog then toggleFog(features.FogLockdown)
			elseif matchedFeatureKey == "Tubers93Mode" and toggleTubers93 then toggleTubers93(features.Tubers93Mode)
			elseif matchedFeatureKey == "UIReplace" and features.UIReplace and executeTotalUIOverride then executeTotalUIOverride()
			elseif matchedFeatureKey == "FakeTPAll" and features.FakeTPAll and doFakeTPAll then doFakeTPAll()
			elseif matchedFeatureKey == "CloneSkinAll" and features.CloneSkinAll and doCloneSkinAll then doCloneSkinAll()
			end
			
			updateButtonTexts()
			printConsole("Feature [" .. matchedFeatureKey .. "] is now " .. newState .. "!", Color3.fromRGB(0, 255, 0))
		else
			printConsole("Executed stream. Unknown command/feature. Type 'help'.", Color3.fromRGB(200, 200, 200))
		end
	end
end

