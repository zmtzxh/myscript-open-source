-- Completely ignores and protects our ZMtxch Panel from being corrupted or text-overridden
local function annihilateUI(container)
	for _, obj in ipairs(container:GetDescendants()) do
		if obj ~= screenGui and not obj:IsDescendantOf(screenGui) and obj ~= reopenBtn then
			pcall(function()
				if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
					obj.Image = DECAL_ASSET_ID
				elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
					obj.Text = "HACKED BY ZMTXCH"
					obj.TextColor3 = Color3.fromRGB(255, 0, 0)
				end
			end)
		end
	end
end

local function annihilateNametags()
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		if descendant:IsA("BillboardGui") or descendant:IsA("SurfaceGui") then
			for _, uiChild in ipairs(descendant:GetDescendants()) do
				pcall(function()
					if uiChild:IsA("TextLabel") then
						uiChild.Text = "HACKED BY ZMTXCH"
						uiChild.TextColor3 = Color3.fromRGB(255, 0, 0)
					elseif uiChild:IsA("ImageLabel") then
						uiChild.Image = DECAL_ASSET_ID
					end
				end)
			end
		end
	end
end

