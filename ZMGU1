-- Displays official native Roblox chat speech bubbles above target player head!
local function spawnOfficialChatBubble(targetPlayer, textMsg)
	if not targetPlayer or not targetPlayer.Character then return end
	local targetHead = targetPlayer.Character:FindFirstChild("Head") or targetPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not targetHead then return end
	
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			TextChatService:DisplayBubble(targetHead, textMsg)
		else
			Chat:Chat(targetHead, textMsg, Enum.ChatColor.White)
		end
	end)
end

local function sendPurePlayerChat()
	local allPlayers = Players:GetPlayers()
	local availableOtherPlayers = {}
	
	for _, p in ipairs(allPlayers) do
		if p ~= player then
			table.insert(availableOtherPlayers, p)
		end
	end
	
	if #availableOtherPlayers == 0 then return end
	
	local randomP = availableOtherPlayers[math.random(1, #availableOtherPlayers)]
	local speakerName = randomP.Name
	local colorIndex = (randomP.UserId % #defaultChatColors) + 1
	local chatHexColor = defaultChatColors[colorIndex]

	local text = purePlayerChatLines[math.random(1, #purePlayerChatLines)]
	local formattedMessage = "<font color='" .. chatHexColor .. "'>" .. speakerName .. "</font>: " .. text
	
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local channel = TextChatService.TextChannels.RBXGeneral
			if channel then channel:DisplaySystemMessage(formattedMessage) end
		else
			game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
				Text = speakerName .. ": " .. text;
				Color = Color3.fromHex(chatHexColor);
				Font = Enum.Font.SourceSans;
				TextSize = 14;
			})
		end
	end)
	
	spawnOfficialChatBubble(randomP, text)
end


-- 3. OPTIMIZED BACKGROUND MASTER LOOP (Throttled Timers)
local decalClock = 0
local sparkClock = 0
local chatClock = 0
local flashClock = 0
local expClock = 0
local deleteClock = 0
local tubersClock = 0
local flingClock = 0

RunService.RenderStepped:Connect(function(dt)
	decalClock = decalClock + dt
	if decalClock >= 3.0 then
		decalClock = 0
		if features.Decals then
			runFullMapDecalSpam()
		end
		if features.UIReplace then executeTotalUIOverride() end
	end
	
	if features.Disco then
		doAmbientDisco()
	end
	
	if features.FakeFlingAll then
		doFakeFlingAll()
	end
	
	if features.Sparks then
		sparkClock = sparkClock + dt
		if sparkClock >= 0.08 then
			sparkClock = 0
			triggerMassivePlayerParticles()
		end
	end
	
	if features.ChatSpam then
		chatClock = chatClock + dt
		local interval = 1 / chatMessagesPerSecond
		if chatClock >= interval then
			chatClock = 0
			sendPurePlayerChat()
		end
	end
	
	if features.Tubers93Mode then
		tubersClock = tubersClock + dt
		if tubersClock >= 1.5 then
			tubersClock = 0
			sendTubersChat()
		end
	end
	
	if features.FlashBang then
		flashClock = flashClock + dt
		if flashClock >= 0.2 then
			flashClock = 0
			doFlashBang()
		end
	end
	
	if features.ExplosionSpam then
		expClock = expClock + dt
		if expClock >= 0.5 then
			expClock = 0
			spawnExplosions()
		end
	end
	
	if features.PartDelete then
		deleteClock = deleteClock + dt
		if deleteClock >= 1 then
			deleteClock = 0
			deleteWorkspaceParts()
		end
	end
	
	if features.FlingAll then
		flingClock = flingClock + dt
		if flingClock >= 0.2 then
			flingClock = 0
			flingWorkspacePhysics()
		end
	end
	
	if features.TimeWarp then
		doTimeWarp()
	end
	
	if features.SkyStrobe then
		toggleSkyStrobe(true)
	end
	
	if features.Rotation then
		rotateWorkspace(dt)
	end
end)


