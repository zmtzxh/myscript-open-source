-- Master Switch logic
local masterAllActive = false
btnMasterAll.MouseButton1Click:Connect(function()
	masterAllActive = not masterAllActive
	btnMasterAll.Text = "Master Override: " .. (masterAllActive and "ON" or "OFF")
	
	for featName, _ in pairs(features) do
		features[featName] = masterAllActive
	end
	
	updateButtonTexts()
	
	if masterAllActive then
		executeTotalUIOverride()
		runFullMapDecalSpam()
		doFakeTPAll()
		doCloneSkinAll()
		if features.StripAnchors then stripAnchors() end
	end
	
	toggleSkybox(masterAllActive)
	toggleLighting(masterAllActive)
	toggleAudio(masterAllActive)
	toggleZeroG(masterAllActive)
	toggleFog(masterAllActive)
	toggleTubers93(masterAllActive)
end)
