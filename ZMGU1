local function rotateWorkspace(dt)
	local rotationCF = CFrame.Angles(0, 0.1 * dt * 60, 0)
	for _, child in ipairs(Workspace:GetChildren()) do
		if child ~= Workspace.CurrentCamera and child ~= player.Character then
			pcall(function()
				if child:IsA("Model") then
					child:PivotTo(child:GetPivot() * rotationCF)
				elseif child:IsA("BasePart") then
					child.CFrame = child.CFrame * rotationCF
				end
			end)
		end
	end
end

